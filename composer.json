{
    "name": "qianxiong/hyperf-flysystem-obs",
    "type": "library",
    "description": "Huawei Cloud OBS adapter for the official hyperf/filesystem component (Flysystem v3).",
    "license": "MIT",
    "keywords": [
        "hyperf",
        "flysystem",
        "filesystem",
        "huawei",
        "huaweicloud",
        "obs",
        "swoole"
    ],
    "authors": [
        {
            "name": "qianxiong"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "hyperf/filesystem": "^3.1",
        "league/flysystem": "^3.0",
        "qianxiong/huaweicloud-obs-sdk": "dev-main",
        "psr/container": "^1.0|^2.0",
        "psr/http-message": "^1.0|^2.0",
        "psr/log": "^1.0|^2.0|^3.0"
    },
    "require-dev": {
        "hyperf/command": "^3.1",
        "hyperf/config": "^3.1",
        "hyperf/di": "^3.1",
        "hyperf/logger": "^3.1"
    },
    "suggest": {
        "hyperf/command": "Required by the obs:check self-check command.",
        "hyperf/logger": "Enables PSR-3 logging of OBS operations and errors."
    },
    "autoload": {
        "psr-4": {
            "Hyperf\\Flysystem\\Obs\\": "src/"
        }
    },
    "extra": {
        "hyperf": {
            "config": "Hyperf\\Flysystem\\Obs\\ConfigProvider"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "@php tests/offline.php",
            "@php tests/readme.php"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
